<Application x:Class="NevaVision.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="App_OnStartup"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#121923" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#182231" />
        <SolidColorBrush x:Key="AccentBrush" Color="#9BE33E" />
        <SolidColorBrush x:Key="TextBrush" Color="#F3F7FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#AAB7C4" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
    </Application.Resources>
</Application>
