<Window x:Class="NevaVision.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Grid Margin="12">
        <Border Background="#D90C121A" BorderBrush="#A09BE33E" BorderThickness="1" CornerRadius="10" Padding="14">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="13" Foreground="#B9D0DE" Text="NevaVision • read-only overlay" />
                <TextBlock x:Name="FishText" Margin="0,8,0,0" FontSize="24" FontWeight="SemiBold" Foreground="#FFFFFF" Text="Ожидание поклёвки…" />
                <TextBlock x:Name="HintText" Margin="0,5,0,0" FontSize="12" Foreground="#AAB7C4" Text="Данные пока не получены" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
